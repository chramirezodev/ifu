# Copiar a .env.local y completar valores
DATABASE_URI=postgresql://payload:payload@127.0.0.1:5433/mardini_cms
PAYLOAD_SECRET=cambia-este-secreto-largo-y-aleatorio
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Seed (opcional)
SEED_ADMIN_EMAIL=admin@mardinilawfirm.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Sitio / analytics
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_GA_ID=

# Formulario de contacto (SMTP del buzón info@mardinilawfirm.com en Hostinger)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@mardinilawfirm.com
# SMTP_PASSWORD=
# Destinatario de los mensajes (por defecto info@mardinilawfirm.com)
# CONTACT_TO_EMAIL=
# reCAPTCHA v3: si RECAPTCHA_SECRET_KEY está definida, el token es obligatorio
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# NEXT_PUBLIC_PAYMENT_URL=
# NEXTAUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
